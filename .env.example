# Constitutional Society of Agents - runtime configuration (copy to .env, fill values)
# .env is git-ignored. Never put keys in code, state, or logs.

# --- Model endpoint (confirmed: D-01) ---
QWEN_BASE_URL=http://100.105.83.8:8080/
QWEN_MODEL_ID=Qwen/Qwen3.8-27B-FP8
# Owner to fill. When unset, the runtime uses the deterministic FakeModel
# backend (CSA_BACKEND=auto) so everything works offline and in tests.
QWEN_API_KEY=

# --- Runtime selection ---
# auto = live if QWEN_API_KEY is set, else fake. (D-09)
# fake = always deterministic offline model. live = always the real endpoint.
CSA_BACKEND=auto
# Reasoning effort defaults (ASSUMPTIONS C-2): routine=medium, deliberation=xhigh, triage=low
CSA_REASONING_EFFORT=medium

# --- Cost / budget guardrails ---
CSA_MAX_TASK_TOKENS=200000
CSA_MAX_TASK_RUN_COST_USD=5.0
CSA_MAX_CONCURRENT_TASKS=1
# $ per 1M tokens (live backend). Unknown pricing -> leave 0, cost stays $0 (tokens still metered).
QWEN_COST_PER_MTOK_IN=0
QWEN_COST_PER_MTOK_OUT=0

# --- Testing / development ---
# Artificial delay per fake model call (ms), used by recovery tests.
CSA_FAKE_DELAY_MS=0
# Storage / artifacts
CSA_DB=csa-data/csa.db
CSA_ARTIFACTS=artifacts/runs
